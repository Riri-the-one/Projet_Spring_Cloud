{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ticketflow:event-envelope:v1",
  "title": "Proposed TicketFlow event envelope v1 — validate with domain owners before producer implementation",
  "type": "object",
  "required": ["eventId", "eventType", "schemaVersion", "source", "occurredAt", "aggregateId", "correlationId", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "schemaVersion": { "const": 1 },
    "source": { "enum": ["event-service", "booking-service", "payment-service", "ticket-service"] },
    "occurredAt": { "type": "string", "format": "date-time", "description": "UTC instant at the producer" },
    "aggregateId": { "type": "string", "minLength": 1, "description": "Business ID serialized as a string" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "data": { "type": "object", "description": "Domain-specific contract, owned by the producing service" }
  },
  "additionalProperties": true
}
