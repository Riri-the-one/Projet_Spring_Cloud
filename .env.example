# Optional TP3 Git mode only. Set the actual repository URL; no credentials in this file.
# CONFIG_GIT_URI=
# Default docker-compose.yml uses native development configuration and needs no secret.

# Demonstration locale uniquement. Ne jamais ajouter de secrets reels dans ce fichier.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
TICKETFLOW_CORS_ORIGINS=http://localhost:4200
# Pour une execution Java depuis Windows (Compose utilise son JWKS interne) :
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/ticketflow
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/ticketflow/protocol/openid-connect/certs
TICKETFLOW_JWT_AUDIENCE=ticketflow-api
# CONFIG_GIT_URI : definir l'URL reelle du depot de configuration uniquement pour le mode Git.
